#!/usr/bin/env bash
# dwm version: prints 1 while the viewed tag(s) of screen $1 (output name) have windows, 0 when its desktop is empty (changes only).
# Reads _RICE_MONS (per monitor: x, y, viewed mask, occupied mask) from dwm; falls back to _RICE_TAGS.
scr=$1
last=""
read -r ox oy < <(xrandr --listmonitors 2>/dev/null | awk -v n="$scr" '$NF==n { split($3,a,"+"); print a[2], a[3] }')
ox=${ox:-0}; oy=${oy:-0}
emit() {
  local t b=0 v o x y
  t=$(xprop -root _RICE_MONS 2>/dev/null | sed -n 's/.*= *//p' | tr -d ' ')
  if [ -n "$t" ]; then
    IFS=, read -ra f <<<"$t"
    for ((i=0; i+3<${#f[@]}; i+=4)); do
      x=${f[i]}; y=${f[i+1]}; v=${f[i+2]}; o=${f[i+3]}
      if [ "$x" = "$ox" ] && [ "$y" = "$oy" ] && [ $(( v & o )) -ne 0 ]; then b=1; fi
    done
  else
    t=$(xprop -root _RICE_TAGS 2>/dev/null | sed -n 's/.*= *//p' | tr -d ' ')
    IFS=, read -r v o _ <<<"${t:-1,0}"
    [ $(( v & o )) -ne 0 ] && b=1
  fi
  if [ "$b" != "$last" ]; then last=$b; echo "$b"; fi
}
emit
while read -r _; do emit; done < <(xprop -root -spy _RICE_MONS _RICE_TAGS)
