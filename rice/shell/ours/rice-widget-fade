#!/usr/bin/env bash
# Hides the desktop widgets while windows are open on their monitor, through the compositor: sets _NET_WM_WINDOW_OPACITY on
# the shell's widget windows. The widgets never re-render (changing a dozen GL windows at once stalled X for ~150 ms per tag switch).
# Reads dwm's _RICE_MONS (per monitor: x y viewed-mask occupied-mask).
LOCK="${XDG_RUNTIME_DIR:-/tmp}/rice-widget-fade.lock"
exec 9>"$LOCK"; flock -n 9 || exit 0
declare -A state mon_busy
wins=(); lastscan=0
mons=()   # "x y w h"
scan_mons() {
  mons=()
  while read -r _ _ g _; do
    [[ $g =~ ^([0-9]+)/[0-9]+x([0-9]+)/[0-9]+\+(-?[0-9]+)\+(-?[0-9]+)$ ]] && mons+=("${BASH_REMATCH[3]} ${BASH_REMATCH[4]} ${BASH_REMATCH[1]} ${BASH_REMATCH[2]}")
  done < <(xrandr --listmonitors 2>/dev/null | tail -n +2)
}
scan_wins() {
  local q w geo ww hh x y m mx my mw mh
  q=$(pgrep -x qs | head -1); [ -n "$q" ] || return
  wins=()
  for w in $(xdotool search --pid "$q" 2>/dev/null); do
    xprop -id "$w" _NET_WM_STATE 2>/dev/null | grep -q BELOW || continue
    eval "$(xdotool getwindowgeometry --shell "$w" 2>/dev/null)"   # X Y WIDTH HEIGHT
    [ "${WIDTH:-0}" -gt 8 ] || continue
    for m in "${mons[@]}"; do
      read -r mx my mw mh <<<"$m"
      # the wallpaper window covers a whole monitor: not a widget
      if [ "$X" -eq "$mx" ] && [ "$Y" -eq "$my" ] && [ "$WIDTH" -ge "$mw" ] && [ "$HEIGHT" -ge "$mh" ]; then continue 2; fi
    done
    wins+=("$w $((X + WIDTH / 2)) $((Y + HEIGHT / 2))")
  done
  lastscan=$SECONDS
}
read_busy() {
  mon_busy=()
  local t f i
  t=$(xprop -root _RICE_MONS 2>/dev/null | sed -n 's/.*= *//p' | tr -d ' ')
  IFS=, read -ra f <<<"$t"
  for ((i=0; i+3<${#f[@]}; i+=4)); do
    (( (f[i+2] & f[i+3]) != 0 )) && mon_busy["${f[i]} ${f[i+1]}"]=1
  done
}
apply() {
  local e w cx cy m mx my mw mh want
  for e in "${wins[@]}"; do
    read -r w cx cy <<<"$e"; want=0
    for m in "${mons[@]}"; do
      read -r mx my mw mh <<<"$m"
      if [ "$cx" -ge "$mx" ] && [ "$cx" -lt $((mx + mw)) ] && [ "$cy" -ge "$my" ] && [ "$cy" -lt $((my + mh)) ]; then
        [ -n "${mon_busy["$mx $my"]:-}" ] && want=1
      fi
    done
    [ "${state[$w]:-}" = "$want" ] && continue
    state[$w]=$want
    if [ "$want" = 1 ]; then xprop -id "$w" -f _NET_WM_WINDOW_OPACITY 32c -set _NET_WM_WINDOW_OPACITY 0
    else xprop -id "$w" -remove _NET_WM_WINDOW_OPACITY; fi
  done
}
cleanup() { local e w; for e in "${wins[@]}"; do read -r w _ <<<"$e"; xprop -id "$w" -remove _NET_WM_WINDOW_OPACITY 2>/dev/null; done; }
trap cleanup EXIT
scan_mons; scan_wins; read_busy; apply
exec 8< <(exec xprop -root -spy _RICE_MONS 9>&-)
while pgrep -x qs >/dev/null; do
  if read -r -t 3 -u 8 _; then
    (( SECONDS - lastscan > 3 )) && scan_wins
  else
    [ $? -gt 128 ] || exit 0      # 8 closed: X went away
    scan_wins                      # timeout: pick up widgets that appeared
  fi
  read_busy; apply
done
