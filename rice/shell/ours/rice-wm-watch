#!/usr/bin/env bash
# dwm state as JSON lines for the Quickshell port: {"view":mask,"occ":mask,"urg":mask,"mon":n,"title":"..","class":".."}
# prints once at start and whenever _RICE_TAGS / the active window change (xprop -spy) or the title changes (2 s poll).
emit() {
  local t v o u m id title cls
  t=$(xprop -root _RICE_TAGS 2>/dev/null | sed -n 's/.*= *//p' | tr -d ' ')
  IFS=, read -r v o u m <<<"${t:-1,0,0,0}"
  id=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | sed -n 's/.*# *//p')
  title=""; cls=""
  if [ -n "$id" ] && [ "$id" != "0x0" ]; then
    title=$(xprop -id "$id" _NET_WM_NAME 2>/dev/null | sed -n 's/^[^=]*= *"\(.*\)"$/\1/p' | head -1)
    cls=$(xprop -id "$id" WM_CLASS 2>/dev/null | sed -n 's/^[^=]*= *"[^"]*", *"\(.*\)"$/\1/p' | head -1)
  fi
  title=${title//\\/\\\\}; title=${title//\"/\\\"}
  printf '{"view":%s,"occ":%s,"urg":%s,"mon":%s,"title":"%s","class":"%s"}\n' "${v:-1}" "${o:-0}" "${u:-0}" "${m:-0}" "$title" "$cls"
}
emit
( while sleep 2; do emit; done ) &
xprop -root -spy _RICE_TAGS _NET_ACTIVE_WINDOW | while read -r _; do emit; done
