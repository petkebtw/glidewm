#!/bin/bash
# Restart PipeWire stack (stale after relogin) and bring the HyperX headset back.
exec 8>"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/audio-fix.lock"
flock -n 8 || exit 0  # one repair at a time
pkill -x pipewire-pulse; pkill -x wireplumber; pkill -x pipewire
sleep 1
setsid gentoo-pipewire-launcher >/dev/null 2>&1 &
sleep 4
pgrep -x pipewire-pulse >/dev/null || { setsid pipewire-pulse >/dev/null 2>&1 & sleep 1; }
card=$(timeout 3 wpctl status | awk '/HyperX/ && /\[alsa\]/ {gsub(/[^0-9]/,"",$2); print $2; exit}')
if [ -n "$card" ]; then
	for i in 2 1 3 4; do
		wpctl set-profile "$card" "$i"; sleep 1.2
		pactl list short sinks | grep -q usb-HP && break
	done
	n=$(pactl list short sinks | awk '/usb-HP/{print $2; exit}')
	[ -n "$n" ] && pactl set-default-sink "$n"
fi
# headset needs the profile with a mono input, otherwise no microphone shows up
timeout 3 pactl set-card-profile alsa_card.usb-HP__Inc_HyperX_Cloud_III_Wireless_0000000000000000-00 output:analog-stereo+input:mono-fallback 2>/dev/null
timeout 3 wpctl status | sed -n '/Sinks:/,/Sources:/p'
