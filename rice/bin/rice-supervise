#!/bin/sh
# rice-supervise CMD [ARGS...]: run a long-lived helper and restart it if it dies (logged to ~/.cache/rice/crash.log).
mkdir -p "$HOME/.cache/rice"
n=0
while :; do
	t0=$(date +%s)
	"$@"
	rc=$?
	[ "$rc" -eq 0 ] && exit 0
	[ "$rc" -eq 143 ] && exit 0       # SIGTERM: stopped on purpose (logout), not a crash
	xprop -root -len 0 _NET_SUPPORTED >/dev/null 2>&1 || exit 0   # X is gone (session ending): nothing to restart into
	printf '\n=== %s supervise: %s exited with %s\n' "$(date '+%F %T')" "$1" "$rc" >> "$HOME/.cache/rice/crash.log"
	[ $(( $(date +%s) - t0 )) -lt 20 ] && n=$((n + 1)) || n=0
	[ "$n" -ge 5 ] && exit 1          # crash loop: give up
	sleep 2
done
