#!/usr/bin/env python3
"""Themed polkit authentication agent (GTK3)."""
import os, sys
sys.path.insert(0, os.path.expanduser("~/.local/lib/rice"))
import gi
gi.require_version("Polkit", "1.0"); gi.require_version("PolkitAgent", "1.0")
import rice
from rice import Gtk, Gdk, GLib
from gi.repository import Gio, Polkit, PolkitAgent


class Dialog(Gtk.Window):
    def __init__(self, message, on_pass, on_cancel):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_wmclass("RiceAuth", "RiceAuth")
        self.set_title("Authentication required")
        self.set_default_size(420, 200)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_keep_above(True)
        self.set_decorated(False)
        self.set_app_paintable(True)
        vis = self.get_screen().get_rgba_visual()
        if vis: self.set_visual(vis)
        self.c = rice.colors()
        self.connect("draw", self._draw)
        css = Gtk.CssProvider()
        c = self.c
        css.load_from_data(f"""
        * {{ font-family: '{rice.FONT}'; color: {c['fg']}; }}
        window {{ background: transparent; }}
        entry {{ background: {c['bg2']}; border: 1px solid {c['border']}; border-radius: 10px; padding: 9px 12px; }}
        entry:focus {{ border-color: {c['accent']}; }}
        button {{ background: {c['bg2']}; border: none; border-radius: 10px; padding: 8px 18px; box-shadow: none; }}
        button.ok {{ background: {c['accent']}; color: {c['bg']}; }}
        button.ok label {{ color: {c['bg']}; }}
        .dim {{ color: {c['dim']}; }}
        """.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        for m in ("start", "end", "top", "bottom"):
            getattr(box, f"set_margin_{m}")(22)
        self.add(box)
        h = Gtk.Label(xalign=0); h.set_markup("<b>  Authentication required</b>")
        box.pack_start(h, False, False, 0)
        msg = Gtk.Label(label=message, xalign=0, wrap=True); msg.set_max_width_chars(42); msg.get_style_context().add_class("dim")
        box.pack_start(msg, False, False, 0)
        self.prompt = Gtk.Label(label="Password:", xalign=0); box.pack_start(self.prompt, False, False, 0)
        self.entry = Gtk.Entry(); self.entry.set_visibility(False)
        self.entry.connect("activate", lambda e: on_pass(e.get_text()))
        box.pack_start(self.entry, False, False, 0)
        self.err = Gtk.Label(label="", xalign=0); box.pack_start(self.err, False, False, 0)
        row = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel"); cancel.connect("clicked", lambda b: on_cancel())
        ok = Gtk.Button(label="Authenticate"); ok.get_style_context().add_class("ok")
        ok.connect("clicked", lambda b: on_pass(self.entry.get_text()))
        row.pack_start(cancel, False, False, 0); row.pack_start(ok, False, False, 0)
        box.pack_start(row, False, False, 0)
        self.connect("key-press-event", lambda w, e: on_cancel() if e.keyval == Gdk.KEY_Escape else None)

    def _draw(self, w, cr):
        import cairo
        a = self.get_allocation()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        rice.rounded(cr, 0.5, 0.5, a.width - 1, a.height - 1, 22)
        cr.set_source_rgba(*rice.rgb(self.c["bg"], 0.92)); cr.fill_preserve()
        cr.set_operator(cairo.OPERATOR_OVER)
        cr.set_source_rgba(*rice.rgb(self.c["accent"], 0.7)); cr.set_line_width(1.5); cr.stroke()


class Agent(PolkitAgent.Listener):
    def do_initiate_authentication(self, action_id, message, icon_name, details, cookie, identities, cancellable, callback, user_data=None):
        task = Gio.Task.new(self, cancellable, callback, user_data)
        ident = next((i for i in identities if isinstance(i, Polkit.UnixUser)), None) or Polkit.UnixUser.new(os.getuid())
        session = PolkitAgent.Session.new(ident, cookie)
        done = {"v": False}

        def finish(ok):
            if done["v"]: return
            done["v"] = True
            dlg.destroy()
            task.return_boolean(ok)

        dlg = Dialog(message, lambda pw: (dlg.err.set_text(""), session.response(pw)), lambda: (session.cancel(), finish(False)))
        session.connect("request", lambda s, prompt, echo: (dlg.prompt.set_text(prompt), dlg.entry.set_text(""), dlg.entry.grab_focus()))
        session.connect("show-error", lambda s, t: dlg.err.set_text(t))
        session.connect("show-info", lambda s, t: dlg.err.set_text(t))
        session.connect("completed", lambda s, gained: finish(True) if gained else (dlg.err.set_text("Wrong password, try again"), s.initiate()) if not done["v"] and not cancellable.is_cancelled() else finish(False))
        cancellable.connect(lambda *a: finish(False))
        if rice.anim_on():
            dlg.get_child().set_opacity(0.0)
        dlg.show_all(); dlg.entry.grab_focus()
        if rice.anim_on():
            rice.fade_child(dlg, 1.0, 170, 170)
        session.initiate()

    def do_initiate_authentication_finish(self, res):
        return res.propagate_boolean()


try:
    subject = Polkit.UnixSession.new_for_process_sync(os.getpid(), None)
except Exception:
    subject = Polkit.UnixProcess.new(os.getpid())
agent = Agent()
agent.register(PolkitAgent.RegisterFlags.NONE, subject, "/org/rice/PolkitAgent", None)
Gtk.main()
