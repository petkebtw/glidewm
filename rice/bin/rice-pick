#!/usr/bin/env python3
"""Screen colour picker: click any pixel, hex goes to the clipboard."""
import os, sys, subprocess
sys.path.insert(0, os.path.expanduser("~/.local/lib/rice"))
import warnings; warnings.filterwarnings("ignore")
import rice, widgets as w
from rice import Gtk, GLib

r = subprocess.run(["slop", "-f", "%x %y", "-t", "0", "-l", "-c", "1,1,1,0.0"], capture_output=True, text=True).stdout.split()
if len(r) != 2:
    sys.exit(0)
x, y = r
png = subprocess.run(["maim", "-u", "-g", f"1x1+{x}+{y}"], capture_output=True).stdout
hx = subprocess.run(["magick", "png:-", "-format", "#%[hex:u.p{0,0}]", "info:"], input=png, capture_output=True).stdout.decode("utf-8", "replace").strip().lower()
if not hx.startswith("#"):
    sys.exit(1)
hx = hx[:7]
subprocess.run(["xclip", "-selection", "clipboard"], input=hx.encode())
t = w.toast(f"{hx}  copied", 2.2)
GLib.timeout_add(2400, Gtk.main_quit)
Gtk.main()
