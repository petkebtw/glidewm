#!/usr/bin/env python3
"""Clipboard history daemon (text + images) -> ~/.cache/clip"""
import os, sys, time, hashlib, gi
sys.path.insert(0, os.path.expanduser("~/.local/lib/rice"))
try:
    import crashlog
except Exception:
    pass
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

D = os.path.expanduser("~/.cache/clip"); os.makedirs(D, exist_ok=True)
MAX = 100
cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
last = None


def prune():
    fs = sorted(os.listdir(D))
    for f in fs[:-MAX]:
        os.remove(os.path.join(D, f))


def changed(*_):
    try:
        _changed()
    except Exception:
        import traceback; traceback.print_exc()   # a bad clipboard must never kill the daemon


def _changed():
    global last
    if cb.wait_is_image_available():
        pb = cb.wait_for_image()
        if pb is None:
            return
        h = hashlib.md5(pb.get_pixels()).hexdigest()
        if h == last:
            return
        last = h
        pb.savev(os.path.join(D, f"{time.time_ns()}.png"), "png", [], [])
    elif cb.wait_is_text_available():
        t = cb.wait_for_text()
        if not t or not t.strip():
            return
        h = hashlib.md5(t.encode()).hexdigest()
        if h == last:
            return
        last = h
        for f in os.listdir(D):  # dedupe identical text
            p = os.path.join(D, f)
            if f.endswith(".txt") and open(p, errors="ignore").read() == t:
                os.remove(p)
        open(os.path.join(D, f"{time.time_ns()}.txt"), "w").write(t)
    prune()


cb.connect("owner-change", changed)
Gtk.main()
