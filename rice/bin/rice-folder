#!/usr/bin/env python3
"""Folder picker: the standard GTK file chooser (same dialog Steam, Firefox etc. use).
   rice-folder [START] [--none LABEL] [--title T]
   Prints the chosen directory on stdout (exit 0). Cancel / Esc = exit 1.
   --none LABEL adds a button that prints an empty line (meaning 'no fixed folder')."""
import os, sys
import warnings; warnings.filterwarnings("ignore")
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk

HOME = os.path.expanduser("~")
a = sys.argv[1:]
none = a[a.index("--none") + 1] if "--none" in a else None
title = a[a.index("--title") + 1] if "--title" in a else "Choose folder"
pos = [x for i, x in enumerate(a) if not x.startswith("--") and (i == 0 or not a[i - 1].startswith("--"))]
start = os.path.expanduser(pos[0]) if pos and os.path.isdir(os.path.expanduser(pos[0])) else HOME

Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
Gtk.Settings.get_default().set_property("gtk-theme-name", "Adwaita-dark")
try:    # accent from the current theme palette
    import json
    c = json.load(open(os.path.expanduser("~/.cache/theme/colors.json")))
    css = Gtk.CssProvider()
    css.load_from_data(f"""
    window, .background {{ background-color: {c['bg']}; color: {c['fg']}; }}
    placessidebar, placessidebar list, treeview.view, .view {{ background-color: {c['bg']}; color: {c['fg']}; }}
    treeview.view:selected, row:selected, placessidebar row:selected {{ background-color: {c['accent']}; color: {c['bg']}; }}
    button.suggested-action {{ background-image: none; background-color: {c['accent']}; color: {c['bg']}; }}
    """.encode())
    Gtk.StyleContext.add_provider_for_screen(__import__("gi.repository.Gdk", fromlist=["Gdk"]).Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_USER)
except Exception:
    pass
dlg = Gtk.FileChooserDialog(title=title, action=Gtk.FileChooserAction.SELECT_FOLDER)
dlg.set_wmclass("rice-folder", "RiceFolder")
dlg.add_button("Cancel", Gtk.ResponseType.CANCEL)
if none:
    dlg.add_button(none, 100)
b_ = dlg.add_button("Select", Gtk.ResponseType.OK)
b_.get_style_context().add_class("suggested-action")
dlg.set_default_response(Gtk.ResponseType.OK)
dlg.set_default_size(820, 560)
dlg.set_position(Gtk.WindowPosition.CENTER)
dlg.set_current_folder(start)
from gi.repository import GLib
dlg.connect('map', lambda *_: GLib.idle_add(lambda: (dlg.resize(820, 560), False)[1]))   # GTK restores its last (possibly huge) size
r = dlg.run()
if r == Gtk.ResponseType.OK:
    print(dlg.get_filename() or start)
    sys.exit(0)
if r == 100:
    print("")
    sys.exit(0)
sys.exit(1)
