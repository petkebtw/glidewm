def xr_outputs():
    """{name: {modes: {'1920x1080': [164.83, ...]}, cur: (res, rate), rot}} parsed from xrandr."""
    res, cur = {}, None
    for ln_ in out("xrandr", t=4).splitlines():
        m = re.match(r"^(\S+) connected(?: primary)? (?:(\d+x\d+)\+\d+\+\d+)?\s*(normal|left|right|inverted)?", ln_)
        if m:
            cur = m.group(1); res[cur] = dict(modes={}, cur=None, rot=m.group(3) or "normal"); continue
        if re.match(r"^\S", ln_):
            cur = None; continue
        mm = re.match(r"^\s+(\d+x\d+)\s+(.*)$", ln_)
        if cur and mm:
            rates = re.findall(r"(\d+\.\d+)([* ]?)([+ ]?)", mm.group(2))
            for rt, star, plus in rates:
                res[cur]["modes"].setdefault(mm.group(1), []).append(float(rt))
                if star == "*":
                    res[cur]["cur"] = (mm.group(1), float(rt))
    return res


for name, info_ in xr_outputs().items():
    g = card(p, name)
    modes = sorted(info_["modes"], key=lambda x: -int(x.split("x")[0]) * int(x.split("x")[1]))
    cr_ = info_["cur"] or (modes[0], info_["modes"][modes[0]][0]) if modes else None
    if not cr_:
        continue
    pick = dict(res=cr_[0], rate=cr_[1], rot=info_["rot"], out=name)
    rate_dd = [None]
    holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)

    def build_rates(pk=pick, im=info_, hd=holder):
        for c in hd.get_children(): hd.remove(c)
        rs = sorted(set(im["modes"].get(pk["res"], [60.0])), reverse=True)
        if pk["rate"] not in rs: pk["rate"] = rs[0]
        hd.pack_start(w.dropdown("Refresh rate", None, [(f"{x:.2f} Hz", x) for x in rs], pk["rate"], lambda v: pk.__setitem__("rate", v), 220), False, False, 0)
        hd.show_all()

    def set_res(v, pk=pick, br=build_rates):
        pk["res"] = v; br()
    g.pack_start(w.dropdown("Resolution", None, [(m_, m_) for m_ in modes], pick["res"], set_res, 220), False, False, 0)
    build_rates(); g.pack_start(holder, False, False, 0)
    g.pack_start(w.dropdown("Orientation", None, [("Normal", "normal"), ("Rotated left", "left"), ("Rotated right", "right"), ("Upside down", "inverted")], pick["rot"], lambda v, pk=pick: pk.__setitem__("rot", v)), False, False, 0)

    def apply_mode(pk=pick):
        sh("xrandr", "--output", pk["out"], "--mode", pk["res"], "--rate", f"{pk['rate']}", "--rotate", pk["rot"])
        GLib.timeout_add(1200, lambda: (w.toast(f"{pk['out']}: {pk['res']} @ {pk['rate']:.0f} Hz"), False)[1])
    g.pack_start(pillbtn("Apply to " + name, apply_mode), False, False, 0)

