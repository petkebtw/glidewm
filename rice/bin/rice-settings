import ipaddress, time
p = page("net", "", "Network", "ip wifi ethernet dns mtu ping lease gateway")
RES = Gtk.Label(xalign=0); RES.set_ellipsize(3)


def say(t, err=False):
    RES.set_markup(f'<span size="10500" foreground="{"#ff7a85" if err else rice.CUR["dim"]}">{GLib.markup_escape_text(t)}</span>')


def bg(fn, *a):
    threading.Thread(target=lambda: GLib.idle_add(*fn(*a)), daemon=True).start()


def sysfs(i, f):
    try: return open(f"/sys/class/net/{i}/{f}").read().strip()
    except OSError: return ""


def human(n):
    for u in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or u == "TB": return f"{n:.1f} {u}" if u != "B" else f"{int(n)} B"
        n /= 1024


def rate(n):
    return human(n) + "/s"


ifaces = []
gw = {}
for ln_ in out("ip", "route").splitlines():
    m = re.match(r"default via (\S+) dev (\S+)", ln_)
    if m: gw[m.group(2)] = m.group(1)
for ln_ in out("ip", "-o", "addr").splitlines():
    f = ln_.split()
    if len(f) >= 4 and f[1] != "lo" and f[2] in ("inet", "inet6") and not (f[2] == "inet6" and f[3].startswith("fe80")):
        ifaces.append((f[1], f[2], f[3]))
names = []
for i_, _f, _a in ifaces:
    if i_ not in names: names.append(i_)
for i_ in os.listdir("/sys/class/net"):
    if i_ != "lo" and i_ not in names and not i_.startswith(("veth", "docker", "br-")): names.append(i_)
live = []
for i_ in names:
    g = card(p, f"{i_}")
    info(g, "State", (sysfs(i_, "operstate") or "?").lower())
    for n_, fam, ad in ifaces:
        if n_ == i_: info(g, "IPv4" if fam == "inet" else "IPv6", ad)
    info(g, "Gateway", gw.get(i_, "-"))
    info(g, "MAC", sysfs(i_, "address") or "-")
    sp_ = sysfs(i_, "speed")
    info(g, "Link speed", (sp_ + " Mb/s") if sp_.lstrip("-").isdigit() and int(sp_) > 0 else "-")
    info(g, "MTU", sysfs(i_, "mtu") or "-")
    lb = Gtk.Label(xalign=0); live.append((i_, lb, [None, None]))
    g.pack_start(lb, False, False, 0)


def tick_rates():
    now = time.time()
    for i_, lb, st in live:
        try:
            rx, tx = int(sysfs(i_, "statistics/rx_bytes")), int(sysfs(i_, "statistics/tx_bytes"))
        except ValueError:
            continue
        txt = f"↓ {human(rx)}   ↑ {human(tx)}"
        if st[0]:
            dt = max(now - st[0][2], 0.1)
            txt += f"      now  ↓ {rate((rx - st[0][0]) / dt)}   ↑ {rate((tx - st[0][1]) / dt)}"
        st[0] = (rx, tx, now)
        lb.set_markup(f'<span size="10500" alpha="75%">{GLib.markup_escape_text(txt)}</span>')
    return True


tick_rates(); GLib.timeout_add(1000, tick_rates)

