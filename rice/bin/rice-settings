PRE = [("Automatic (DHCP)", "auto"), ("Cloudflare", "1.1.1.1 1.0.0.1"), ("Google", "8.8.8.8 8.8.4.4"),
       ("Quad9", "9.9.9.9 149.112.112.112"), ("AdGuard", "94.140.14.14 94.140.15.15"), ("Custom …", "custom")]
