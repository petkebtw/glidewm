def on_key(wd, e):
    if capture[0]:
        return capture[0].got(e) or True
    if e.keyval == Gdk.KEY_Escape:
        if ent.get_text(): ent.set_text("")
        else: panel.quit_anim()
        return True
    return False


def on_press(wd, e):
    a = panel.get_allocation()
    if e.button == 3 or not (0 <= e.x <= a.width and 0 <= e.y <= a.height):
        panel.quit_anim(); return True
    return False


def grab():
    seat = Gdk.Display.get_default().get_default_seat()
    if seat.grab(panel.get_window(), Gdk.SeatCapabilities.ALL, True, None, None, None) == Gdk.GrabStatus.SUCCESS:
        return False
    grab.n += 1
    return grab.n < 30


grab.n = 0
panel.add_events(Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
panel.connect("key-press-event", on_key)
panel.connect("button-press-event", on_press)
panel.show_all()
goto(sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] in NAVS else "home")
GLib.timeout_add(120, grab)
GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda *a: (panel.quit_anim(), True)[1])
Gtk.main()
try: os.remove(PID)
except OSError: pass
