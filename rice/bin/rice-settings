def drawsw(wd, cr):
    c = rice.colors(); keys = ("bg", "bg2", "border", "dim", "fg", "accent", "accent2")
    W = wd.get_allocated_width(); n = len(keys); gap = 8; ww = (W - gap * (n - 1)) / n
    for i, k in enumerate(keys):
        rice.rounded(cr, i * (ww + gap), 0, ww, 40, 12); cr.set_source_rgba(*rice.rgb(c[k])); cr.fill()
        rice.rounded(cr, i * (ww + gap) + .5, .5, ww - 1, 39, 12); cr.set_source_rgba(*w.col("fg", 0.15)); cr.set_line_width(1); cr.stroke()
    return False
sw.connect("draw", drawsw); g.pack_start(sw, False, False, 0)
