p = page("keys", "", "Shortcuts", "keybinds hotkeys keys shortcuts")
BINDS = os.path.expanduser("~/.config/rice/binds.conf")
os.makedirs(os.path.dirname(BINDS), exist_ok=True)


def seed():
    for exe in (f"{HOME}/dwm/mwm", "/usr/local/bin/mwm", "mwm", f"{HOME}/dwm/dwm", "dwm"):
        o = out(exe, "--dump-binds", t=3)
        if o.count("=") > 10:
            open(BINDS, "w").write(o + "\n")
            return True
    return False


if not os.path.exists(BINDS):
    seed()
binds = []
if os.path.exists(BINDS):
    for ln_ in open(BINDS):
        t_ = ln_.split("#")[0].strip()
        if "=" not in t_: continue
        c_, a_ = t_.split("=", 1)
        a_ = a_.strip().split(None, 1)
        if a_: binds.append(dict(combo=c_.strip(), act=a_[0], arg=a_[1] if len(a_) > 1 else ""))
NICE = dict(killclient="Close window", focusstack="Focus next / previous", zoom="Make master", setlayout="Toggle layout", cyclelayout="Next layout",
            resetlayout="Default layout (tile)", togglefloating="Toggle floating", togglebar="Toggle bar", setgaps="Gaps", focusmon="Focus monitor",
            tagmon="Send to monitor", snapwin="Snap window", movewin="Nudge window", sizewin="Resize window", togglecanvas="Canvas mode",
            quit="Quit dwm", xrdb="Reload colours", incnmaster="Master count", setmfact="Master size", movestack="Move window in stack",
            view="Go to workspace", toggleview="Show workspace too", tag="Move to workspace", toggletag="Also on workspace")
CMDN = {"theme-switch": "Themes", "rice-tools": "Tools", "rice-settings": "Settings", "rice-search": "Search", "clip-pick": "Clipboard", "rice-media": "Media card",
        "screenshot.sh": "Screenshot", "rice-lock": "Lock screen", "rice-record": "Screen recorder", "konsole": "Terminal", "rofi-launcher": "App launcher",
        "dwm-volume": "Volume", "rice-media": "Media"}
DIRN = {"0": "left", "1": "right", "2": "up", "3": "down"}


def nice(b):
    a, g_ = b["act"], b["arg"]
    if a == "spawn":
        first = os.path.basename(g_.split()[0]) if g_.split() else ""
        n = CMDN.get(first, g_[:36])
        return n + (" " + g_.split(None, 1)[1] if first in ("dwm-volume",) and len(g_.split()) > 1 else "") if first != "rice-media" else ("Media " + g_.split()[-1] if len(g_.split()) > 1 else "Media card")
    n = NICE.get(a, a)
    if a in ("snapwin", "movewin", "sizewin"): n += " " + DIRN.get(g_, g_)
    elif a in ("setgaps",): n += {"0": " reset", "2": " +", "-2": " −"}.get(g_, "")
    elif a in ("view", "toggleview", "tag", "toggletag"): n += " " + g_
    elif a in ("focusstack", "movestack", "focusmon", "tagmon", "cyclelayout"): n += " " + ("next" if g_.startswith("1") or g_.startswith("+") else "previous")
    elif a in ("incnmaster", "setmfact"): n += " " + ("+" if not g_.startswith("-") else "−")
    return n


def group(b):
    a = b["act"]
    if a == "spawn": return "Programs"
    if a in ("view", "toggleview", "tag", "toggletag"): return "Workspaces"
    if a in ("cyclelayout", "setlayout", "resetlayout", "setmfact", "incnmaster", "setgaps", "togglebar"): return "Layout"
    if a in ("focusmon", "tagmon"): return "Monitors"
    if a in ("quit", "xrdb"): return "System"
    return "Windows"


def save_binds():
    with open(BINDS, "w") as f:
        f.write("# dwm keybinds: <Mod+Shift+key> = <action> [argument]   (Mod = Alt). Edited by rice-settings.\n")
        for b in binds:
            f.write(f"{b['combo']} = {b['act']}" + (f" {b['arg']}" if b["arg"] else "") + "\n")
    sh("xprop", "-root", "-f", "_RICE_CMD", "32c", "-set", "_RICE_CMD", "5, 0")


capture = [None]
MODS = ((Gdk.ModifierType.MOD1_MASK, "Mod"), (Gdk.ModifierType.SHIFT_MASK, "Shift"), (Gdk.ModifierType.CONTROL_MASK, "Ctrl"), (Gdk.ModifierType.MOD4_MASK, "Super"))


def combo_from(e):
    km = Gdk.Keymap.get_for_display(Gdk.Display.get_default())
    ok, kv, *_ = km.translate_keyboard_state(e.hardware_keycode, 0, e.group)
    name = Gdk.keyval_name(kv if ok else e.keyval) or ""
    if not name or name.endswith(("_L", "_R")) or name in ("Mode_switch", "ISO_Level3_Shift", "Caps_Lock", "Num_Lock"):
        return None
    return "+".join([n for m, n in MODS if e.state & m] + [name])


class KeyRow(Gtk.Box):
    def __init__(self, b):
        super().__init__(spacing=8)
        self.b = b
        l = Gtk.Label(xalign=0); l.set_markup(f'<span size="11500">{GLib.markup_escape_text(nice(b))}</span>'); l.set_ellipsize(3)
        self.pack_start(l, True, True, 0)
        self.btn = Gtk.Button(); self.btn.get_style_context().add_class("pill"); self.btn.set_size_request(230, -1)
        self.btn.connect("clicked", lambda *_: self.listen())
        self.pack_end(self.btn, False, False, 0)
        if b["act"] == "spawn":
            x = Gtk.Button(label="✕"); x.get_style_context().add_class("pill"); x.connect("clicked", lambda *_: self.remove_bind())
            self.pack_end(x, False, False, 0)
        self.paint()

    def paint(self):
        self.btn.set_label(self.b["combo"] or "unassigned")

    def listen(self):
        if capture[0]: capture[0].paint()
        capture[0] = self
        self.btn.set_label("press the new keys …   (Esc cancel, Del unbind)")

    def got(self, e):
        if e.keyval == Gdk.KEY_Escape:
            pass
        elif e.keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace):
            self.b["combo"] = ""; save_binds()
        else:
            c = combo_from(e)
            if c is None: return False
            clash = next((o for o in binds if o is not self.b and o["combo"] == c), None)
            if clash:
                w.toast(f"{c} is already used by: {nice(clash)}")
            else:
                self.b["combo"] = c; save_binds()
        capture[0] = None; self.paint(); return True

    def remove_bind(self):
        binds.remove(self.b); save_binds(); self.get_parent().remove(self)


if not binds:
    info(card(p), "No binds file", "build dwm first (needs --dump-binds), then reopen")
else:
    order = ["Programs", "Layout", "Windows", "Workspaces", "Monitors", "System"]
    cards = {k: card(p, k) for k in order}
    for k_, bx in cards.items(): bx.set_spacing(6)
    for b in binds:
        cards[group(b)].pack_start(KeyRow(b), False, False, 0)
    g = card(p, "Add a shortcut")
    ne = w.entry("command to run, e.g. firefox-mullvad", 300)
    def add_bind():
        cmd_ = ne.get_text().strip()
        if not cmd_: return w.toast("type a command first")
        b = dict(combo="", act="spawn", arg=cmd_); binds.append(b)
        r_ = KeyRow(b); cards["Programs"].pack_start(r_, False, False, 0); r_.show_all(); r_.listen(); ne.set_text("")
    g.pack_start(ne, False, False, 0)
    g.pack_start(pillbtn("Add and choose keys", add_bind), False, False, 0)
    def reset_binds():
        try: os.remove(BINDS)
        except OSError: pass
        sh("xprop", "-root", "-f", "_RICE_CMD", "32c", "-set", "_RICE_CMD", "5, 0"); w.toast("Defaults restored. Reopen settings.")
    g.pack_start(pillbtn("Reset all shortcuts to defaults", reset_binds), False, False, 0)

