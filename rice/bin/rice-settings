def folder(d):
    n = s = 0
    try:
        for f in os.scandir(d):
            if f.is_file(): n += 1; s += f.stat().st_size
    except OSError: pass
    return n, s / 1e6
ln, ls = folder(themes.WALLS); on, os_ = folder(themes.ONLINE)
info(g, "On this computer", f"{ln} files, {ls:.0f} MB")
info(g, "Downloaded", f"{on} files, {os_:.0f} MB (max {themes.MAX_ONLINE})")
def clear_online():
    cur_ = os.path.realpath(open(f"{themes.CACHE}/wall").read().strip()) if os.path.exists(f"{themes.CACHE}/wall") else ""
    for f in os.scandir(themes.ONLINE):
        if f.is_file() and os.path.realpath(f.path) != cur_:
            try: os.remove(f.path)
            except OSError: pass
    w.toast("Downloaded wallpapers cleared")
g.pack_start(pillbtn("Clear downloaded wallpapers", clear_online), False, False, 0)

