prev = ["look"]


def do_search(e):
    q = e.get_text().lower().strip()
    if not q:
        goto(prev[0]); return
    if stack.get_visible_child_name() != "search":
        prev[0] = stack.get_visible_child_name()
    for c in sb.get_children(): sb.remove(c)
    t = Gtk.Label(xalign=0); t.set_markup('<span size="19000" weight="bold">Search</span>'); sb.pack_start(t, False, False, 6)
    hits = [(pg, lb) for pg, lb, kw in INDEX if q in lb.lower() or q in kw.lower()]
    seen = set()
    for pg, lb in hits:
        if (pg, lb) in seen: continue
        seen.add((pg, lb))
        bt = Gtk.Button(); bt.get_style_context().add_class("pill")
        bt.set_label(f"{lb}      ›  {dict((k, n.label) for k, n in NAVS.items())[pg]}"); bt.get_child().set_xalign(0)
        bt.connect("clicked", lambda _b, pg=pg: (ent.set_text(""), goto(pg)))
        sb.pack_start(bt, False, False, 0)
    if not hits:
        n = Gtk.Label(); n.set_markup('<span alpha="55%">nothing found</span>'); sb.pack_start(n, False, False, 0)
    sb.show_all()
    stack.set_visible_child_name("search")
    for n in NAVS.values(): n.sel = False; n.queue_draw()


ent.connect("changed", do_search)
side.pack_start(Gtk.Box(), True, True, 0)
side.pack_end(Gtk.Label(label=""), False, False, 0)

