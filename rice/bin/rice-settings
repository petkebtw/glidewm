IFACE = names[0] if names else "eno1"


def asroot(script, ok_msg):
    """Run a shell script as root through pkexec (polkit-agent shows the prompt) and report."""
    def work():
        try:
            r_ = subprocess.run(["pkexec", "sh", "-c", script], capture_output=True, text=True, timeout=120)
            ok = r_.returncode == 0
            msg = ok_msg if ok else ("cancelled" if r_.returncode in (126, 127) else (r_.stderr.strip().splitlines() or ["failed"])[-1])
        except Exception as e:
            ok, msg = False, str(e)
        GLib.idle_add(lambda: (say(msg, not ok), show_dns(), False)[2])
    say("waiting for authorisation …")
    threading.Thread(target=work, daemon=True).start()


def apply_dns():
    v = dsel[0]
    if v == "auto":
        script = f"rm -f /etc/resolv.conf.head; sed -i '/# rice-dns/,+1d' /etc/dhcpcd.conf; dhcpcd -n {IFACE} >/dev/null 2>&1; true"
        return asroot(script, "DNS is automatic again")
    if v == "custom":
        v = " ".join(x.get_text().strip() for x in (c1, c2) if x.get_text().strip())
    try:
        servers = [str(ipaddress.ip_address(x)) for x in v.split()]
    except ValueError:
        return say("not a valid IP address", True)
    if not servers:
        return say("enter at least one server", True)
    ns = "\\n".join("nameserver " + x for x in servers)
    script = (f"set -e; printf '# rice-dns\\n{ns}\\n' > /etc/resolv.conf.head; "
              f"grep -q '# rice-dns' /etc/dhcpcd.conf || printf '\\n# rice-dns\\nnooption domain_name_servers\\n' >> /etc/dhcpcd.conf; "
              f"dhcpcd -n {IFACE} >/dev/null 2>&1 || true; printf '{ns}\\n' > /etc/resolv.conf")
    asroot(script, "DNS set: " + ", ".join(servers))


g.pack_start(pillbtn("Apply DNS", apply_dns), False, False, 0)

