#!/usr/bin/env python3
"""System settings: big panel from the right edge, sidebar + pages (like KDE System Settings). Mod+o. Run again / Esc closes."""
import os, sys, re, signal, subprocess, threading, shutil
# single instance (spam-safe): decided before the heavy imports
import fcntl as _fc, signal as _sg
_cd = os.path.expanduser("~/.cache/rice"); os.makedirs(_cd, exist_ok=True)
_lk = open(os.path.join(_cd, "once-rice-settings.lock"), "w")
try:
    _fc.flock(_lk, _fc.LOCK_EX | _fc.LOCK_NB)
except OSError:
    if False:
        try: os.kill(int(open(os.path.join(_cd, "once-rice-settings.pid")).read()), _sg.SIGTERM)
        except Exception: pass
    sys.exit(0)
open(os.path.join(_cd, "once-rice-settings.pid"), "w").write(str(os.getpid()))

PID = os.path.expanduser("~/.cache/rice/settings.pid")
try:
    old = int(open(PID).read())
    if "rice-settings" in open(f"/proc/{old}/cmdline").read() and old != os.getpid():
        os.kill(old, signal.SIGTERM); sys.exit(0)
except Exception:
    pass
open(PID, "w").write(str(os.getpid()))
signal.signal(signal.SIGUSR1, signal.SIG_IGN)
sys.path.insert(0, os.path.expanduser("~/.local/lib/rice"))
import warnings; warnings.filterwarnings("ignore")
import rice, themes, settings, widgets as w
from rice import Gtk, Gdk, GLib

HOME = os.path.expanduser("~")
S = settings.load()
panel = rice.Panel(900)
SIDE = 250


def sh(*a):
    subprocess.Popen(list(a), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, stdin=subprocess.DEVNULL)


def out(*a, t=3):
    try:
        return subprocess.run(["timeout", str(t), *a], capture_output=True, text=True).stdout.strip()
    except Exception:
        return ""


def reapply():
    def work():
        try:
            wall = open(f"{themes.CACHE}/wall").read().strip(); name = open(f"{themes.CACHE}/current").read().strip()
            themes.apply(dict(name=name, wall=wall, colors=None), final=True)
        except Exception:
            pass
        GLib.idle_add(lambda: (panel.restyle(), panel.queue_draw(), root.queue_draw(), False)[3])
    threading.Thread(target=work, daemon=True).start()


def sysset(key, apply_=True):
    def f(v):
        settings.sput(key, v)
        if apply_:
            sh("rice-apply")
    return f


def setting(key, re_=False):
    return lambda v: (settings.put(key, v), reapply() if re_ else None)


# ------------------------------------------------------------------ layout
root = Gtk.Box()
panel.add(root)
side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
side.set_size_request(SIDE, -1)
for m, v in (("start", 14), ("end", 8), ("top", 18), ("bottom", 14)):
    getattr(side, f"set_margin_{m}")(v)
root.pack_start(side, False, False, 0)
stack = Gtk.Stack(); stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE); stack.set_transition_duration(160)
root.pack_start(stack, True, True, 0)

INDEX = []        # (page, label, keywords) for the search box
NAVS = {}


class Nav(w.Anim):
    def __init__(self, glyph, label, page):
        super().__init__(0.0, 0.3)
        self.glyph, self.label, self.page, self.sel = glyph, label, page, False
        self.set_size_request(SIDE - 22, 40)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("draw", self._d)
        self.connect("button-press-event", lambda *a: (goto(page), True)[1])
        self.connect("enter-notify-event", lambda *a: self.go(1.0))
        self.connect("leave-notify-event", lambda *a: self.go(0.0))

    def _d(self, wd, cr):
        W, H = self.get_allocated_width(), self.get_allocated_height()
        rice.rounded(cr, 0, 2, W, H - 4, 14)
        if self.sel:
            cr.set_source_rgba(*w.col("accent")); cr.fill()
        else:
            cr.set_source_rgba(*w.col("fg", 0.09 * self.v)); cr.fill()
        on = self.sel
        w.icon(cr, self.glyph, 24, H / 2 + 6, 16, "bg" if on else "accent")
        w.text(cr, self.label, 46, H / 2 + 4.5, 12.5, on, "bg" if on else "fg")
        return False


def goto(page):
    stack.set_visible_child_name(page)
    for k, n in NAVS.items():
        n.sel = (k == page); n.queue_draw()


def page(name, glyph, label, kw=""):
    sc = Gtk.ScrolledWindow(); sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    for m, v in (("start", 30), ("end", 30), ("top", 24), ("bottom", 24)):
        getattr(b, f"set_margin_{m}")(v)
    sc.add(b)
    t = Gtk.Label(xalign=0); t.set_markup(f'<span size="19000" weight="bold">{GLib.markup_escape_text(label)}</span>')
    b.pack_start(t, False, False, 6)
    stack.add_named(sc, name)
    n = Nav(glyph, label, name); NAVS[name] = n
    side.pack_start(n, False, False, 0)
    INDEX.append((name, label, kw))
    return b


def card(b, title=None):
    """Grouped block of rows with a soft background."""
    if title:
        b.pack_start(w.heading(title), False, False, 4)
    g = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    _m3css()
    g.get_style_context().add_class("m3card")      # Material 3 style: grouped rows sit on a rounded tonal surface
    b.pack_start(g, False, False, 0)
    return g


_M3 = []
def _m3css():
    if _M3: return
    c = rice.colors()
    css = Gtk.CssProvider()
    css.load_from_data(f".m3card {{ background: alpha({c['fg']}, 0.045); border-radius: 22px; padding: 16px 18px; }}".encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
    _M3.append(css)


def r(b, page_name, label, ctl, sub=None, kw=""):
    INDEX.append((page_name, label, kw + " " + (sub or "")))
    b.pack_start(w.row(label, ctl, sub), False, False, 0)


def info(b, k, v):
    h = Gtk.Box(spacing=10)
    a = Gtk.Label(xalign=0); a.set_markup(f'<span size="11000" alpha="60%">{GLib.markup_escape_text(k)}</span>'); a.set_size_request(200, -1)
    c = Gtk.Label(xalign=0); c.set_markup(f'<span size="11500">{GLib.markup_escape_text(v)}</span>'); c.set_ellipsize(3); c.set_selectable(False)
    h.pack_start(a, False, False, 0); h.pack_start(c, True, True, 0)
    b.pack_start(h, False, False, 0)


def pillbtn(label, cb):
    b = Gtk.Button(label=label); b.get_style_context().add_class("pill"); b.connect("clicked", lambda *_: cb()); return b


def launcher(cmd):
    return lambda: (panel.quit_anim(), GLib.timeout_add(260, lambda: (sh(*cmd), False)[1]))


def radio_list(b, items, current, on_pick):
    """items [(label, value)] -> column of pill buttons, the current one marked."""
    btns = []

    def paint():
        for bt, (l, v) in zip(btns, items):
            bt.set_label(("●  " if v == state[0] else "○  ") + l)
    state = [current]
    for l, v in items:
        bt = Gtk.Button(); bt.get_style_context().add_class("pill"); bt.get_child() if False else None
        bt.connect("clicked", lambda _b, v=v: (state.__setitem__(0, v), paint(), on_pick(v)))
        btns.append(bt); b.pack_start(bt, False, False, 0)
    paint()


