g = card(p, "Diagnostics")
def t_ping():
    o = out("ping", "-c", "3", "-W", "2", "1.1.1.1", t=8)
    m = re.search(r"= [\d.]+/([\d.]+)/", o)
    return (lambda: (say(f"internet: 1.1.1.1 answers in {m.group(1)} ms" if m else "no reply from 1.1.1.1", not m), False)[1],)
def t_gw():
    gws = list(gw.values())
    if not gws: return (lambda: (say("no default gateway", True), False)[1],)
    o = out("ping", "-c", "3", "-W", "2", gws[0], t=8)
    m = re.search(r"= [\d.]+/([\d.]+)/", o)
    return (lambda: (say(f"router {gws[0]}: {m.group(1)} ms" if m else f"router {gws[0]} does not answer", not m), False)[1],)
def t_dns():
    t0 = time.time(); o = out("getent", "hosts", "example.com", t=6); dt = (time.time() - t0) * 1000
    return (lambda: (say(f"DNS ok: example.com -> {o.split()[0]} in {dt:.0f} ms" if o else "DNS lookup failed", not o), False)[1],)
def t_pub():
    o = out("curl", "-s", "-m", "6", "https://api.ipify.org", t=8)
    return (lambda: (say("public IP: " + o if o else "could not reach api.ipify.org", not o), False)[1],)
def t_conn():
    o = out("ss", "-Htn", "state", "established", t=3)
    n = len(o.splitlines())
    return (lambda: (say(f"{n} established TCP connections"), False)[1],)
tb = Gtk.Grid(column_spacing=6, row_spacing=6, column_homogeneous=True)
for ti_, (l_, f_) in enumerate( (("Ping internet", t_ping), ("Ping router", t_gw), ("DNS lookup", t_dns), ("Public IP", t_pub), ("Connections", t_conn))):
    tb.attach(pillbtn(l_, lambda f_=f_, l_=l_: (say(l_ + " …"), bg(f_))), ti_ % 3, ti_ // 3, 1, 1)
g.pack_start(tb, False, False, 0)
g.pack_start(RES, False, False, 0)

