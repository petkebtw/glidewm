# ------------------------------------------------------------------ keys, grab, signals
def on_key(wd, e):
    k = e.keyval
    if k in (Gdk.KEY_Escape, Gdk.KEY_q):
        panel.quit_anim(); return True
    if k in (Gdk.KEY_1, Gdk.KEY_2, Gdk.KEY_3, Gdk.KEY_4):
        goto(TABS[k - Gdk.KEY_1]); return True
    if k in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab, Gdk.KEY_Right, Gdk.KEY_Left):
        d = -1 if k in (Gdk.KEY_ISO_Left_Tab, Gdk.KEY_Left) or e.state & Gdk.ModifierType.SHIFT_MASK else 1
        goto(TABS[(TABS.index(CUR[0]) + d) % len(TABS)]); return True
    return False


def on_press(wd, e):
    a = panel.get_allocation()
    if not (0 <= e.x <= a.width and 0 <= e.y <= a.height):
        panel.quit_anim(); return True
    return False


def req_tab():
    try:
        t = open(TABF + ".req").read().strip(); os.remove(TABF + ".req")
    except OSError:
        return True
    if t in TABS:
        goto(t)
    return True


panel.add_events(Gdk.EventMask.KEY_PRESS_MASK | Gdk.EventMask.BUTTON_PRESS_MASK)
panel.connect("key-press-event", on_key)
panel.connect("button-press-event", on_press)
panel.show_all()
goto(want or "control", animate=False)
w.grab_keys(panel)
GLib.timeout_add(1000, control_tick)
GLib.timeout_add(1000, today_tick)
GLib.timeout_add(1500, sys_tick)
GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda *a: (panel.quit_anim(), True)[1])
GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, lambda *a: req_tab())
Gtk.main()
try:
    if int(open(PID).read()) == os.getpid():
        os.remove(PID)
    os.remove(TABF)
except (OSError, ValueError):
    pass
