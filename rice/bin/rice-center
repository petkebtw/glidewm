CH = 262


def cal_draw(wd, cr):
    import calendar
    W, H = wd.get_allocated_width(), wd.get_allocated_height()
    soft(cr, 0, 0, W, H, 22, 0.06)
    y, m = CAL["y"], CAL["m"]
    today = time.localtime()
    w.text(cr, f"{calendar.month_name[m]} {y}", 18, 32, 14, True)
    for k, g, cx in (("prev", "", W - 64), ("next", "", W - 30)):
        cr.arc(cx, 27, 13, 0, 2 * math.pi)
        cr.set_source_rgba(*w.col("fg", 0.14 if CAL["hot"] == k else 0.07)); cr.fill()
        w.icon(cr, g, cx, 31.5, 11, "fg")
    cw = (W - 20) / 7.0
    for i, d in enumerate(("Mo", "Tu", "We", "Th", "Fr", "Sa", "Su")):
        w.text(cr, d, 10 + cw * (i + 0.5), 62, 9.5, True, "dim", 0.8 if i < 5 else 0.55, "c")
    weeks = calendar.Calendar(0).monthdatescalendar(y, m)
    rh = (H - 78) / 6.0
    for r, wk in enumerate(weeks):
        for i, d in enumerate(wk):
            cx, cy = 10 + cw * (i + 0.5), 78 + rh * (r + 0.5)
            is_today = (d.year, d.month, d.day) == (today.tm_year, today.tm_mon, today.tm_mday)
            if is_today:
                cr.arc(cx, cy, 14, 0, 2 * math.pi); cr.set_source_rgba(*w.col("accent")); cr.fill()
            inm = d.month == m
            w.text(cr, str(d.day), cx, cy + 4, 11, is_today, "bg" if is_today else ("fg" if inm else "dim"),
                   1.0 if (inm or is_today) else 0.35, "c")
    return False


def cal_hit(wd, x, y):
    W = wd.get_allocated_width()
    for k, cx in (("prev", W - 64), ("next", W - 30)):
        if (x - cx) ** 2 + (y - 27) ** 2 < 16 ** 2:
            return k
    if y < 44 and x < W - 90:
        return "title"
    return None


def cal_press(wd, e):
    k = cal_hit(wd, e.x, e.y)
    if k == "prev":
        CAL["m"] -= 1
        if CAL["m"] < 1: CAL["m"], CAL["y"] = 12, CAL["y"] - 1
    elif k == "next":
        CAL["m"] += 1
        if CAL["m"] > 12: CAL["m"], CAL["y"] = 1, CAL["y"] + 1
    elif k == "title":
        lt = time.localtime(); CAL["y"], CAL["m"] = lt.tm_year, lt.tm_mon
    wd.queue_draw()
    return True


def cal_motion(wd, e):
    k = cal_hit(wd, e.x, e.y)
    if k != CAL["hot"]:
        CAL["hot"] = k; wd.queue_draw()
    return False


lt0 = time.localtime(); CAL["y"], CAL["m"] = lt0.tm_year, lt0.tm_mon
cal = area(CW, CH, cal_draw, cal_press, cal_motion, lambda wd, e: (CAL.update(hot=None), wd.queue_draw(), False)[2])
pt.pack_start(cal, False, False, 0)

# ---- weather (wttr.in, cached 30 min)
WFILE = os.path.join(CACHE, "weather.json")
WX = dict(d=None, ts=0, state="loading")


def wx_icon(code):
    c = int(code or 113)
    if c == 113: return ""
    if c == 116: return ""
    if c in (119, 122): return ""
    if c in (143, 248, 260): return ""
    if c in (200, 386, 389, 392, 395): return ""
    if c in (179, 182, 185, 227, 230, 311, 314, 317, 320, 323, 326, 329, 332, 335, 338, 350, 362, 365, 368, 371, 374, 377): return ""
    return ""


def wx_load():
    def work():
        try:
            c = json.load(open(WFILE))
            if time.time() - c.get("ts", 0) < 1800 and c.get("d"):
                return c["d"], c["ts"], "ok"
        except Exception:
            c = None
        try:
            import urllib.request
            rq = urllib.request.Request("https://wttr.in/?format=j1", headers={"User-Agent": "curl/8.0"})
            with urllib.request.urlopen(rq, timeout=4) as r:
                d = json.loads(r.read().decode())
            cur = d["current_condition"][0]
            area_ = (d.get("nearest_area") or [{}])[0]
            small = dict(temp=cur.get("temp_C"), feels=cur.get("FeelsLikeC"), hum=cur.get("humidity"),
                         wind=cur.get("windspeedKmph"), desc=(cur.get("weatherDesc") or [{}])[0].get("value", ""),
                         code=cur.get("weatherCode"),
                         place=((area_.get("areaName") or [{}])[0].get("value", "")),
                         days=[dict(date=x.get("date"), hi=x.get("maxtempC"), lo=x.get("mintempC"),
                                    code=(x.get("hourly") or [{}] * 5)[4].get("weatherCode") if len(x.get("hourly") or []) > 4 else 113)
                               for x in (d.get("weather") or [])[:3]])
            ts = time.time()
            tmp = WFILE + ".tmp"
            json.dump(dict(ts=ts, d=small), open(tmp, "w")); os.replace(tmp, WFILE)
            return small, ts, "ok"
        except Exception:
            if c and c.get("d"):
                return c["d"], c.get("ts", 0), "stale"
            return None, 0, "offline"

    def done(r):
        if r:
            WX["d"], WX["ts"], WX["state"] = r
        weather.queue_draw()
    bg(work, done)


def wx_draw(wd, cr):
    W, H = wd.get_allocated_width(), wd.get_allocated_height()
    soft(cr, 0, 0, W, H, 22, 0.06)
    d = WX["d"]
    if not d:
        w.icon(cr, "", 46, 70, 34, "dim")
        w.text(cr, "Weather" if WX["state"] == "loading" else "Weather unavailable", 90, 58, 13, True)
        w.text(cr, "loading …" if WX["state"] == "loading" else "offline, will retry next time", 90, 78, 10, False, "dim")
        return False
    w.icon(cr, wx_icon(d.get("code")), 46, 66, 34, "accent")
    adv = w.text(cr, f"{d.get('temp', '?')}°", 88, 66, 34, True)
    w.text(cr, "C", 88 + adv + 2, 50, 12, True, "dim")
    tx = W - 16
    w.text(cr, fit(cr, d.get("desc", ""), 11.5, W - 200, True), tx, 34, 11.5, True, "fg", 1, "r")
    w.text(cr, f"feels {d.get('feels', '?')}°  ·  {d.get('hum', '?')}% hum", tx, 54, 9.5, False, "dim", 1, "r")
    w.text(cr, f"wind {d.get('wind', '?')} km/h", tx, 70, 9.5, False, "dim", 1, "r")
    place = d.get("place") or ""
    if WX["state"] == "stale":
        mins = int((time.time() - WX["ts"]) / 60)
        place = f"offline · {mins // 60}h {mins % 60}m old" if mins >= 60 else f"offline · {mins}m old"
    w.text(cr, fit(cr, place, 9.5, 150), 20, 92, 9.5, False, "dim")
    days = d.get("days") or []
    if days:
        import datetime
        cw = (W - 24) / len(days)
        for i, x in enumerate(days):
            cx = 12 + cw * (i + 0.5)
            soft(cr, 12 + cw * i + 3, 104, cw - 6, H - 116, 14, 0.06)
            try:
                nm = "Today" if i == 0 else datetime.date.fromisoformat(x["date"]).strftime("%a")
            except Exception:
                nm = ""
            w.text(cr, nm, cx - 22, 126, 10, True, "fg", 1, "c")
            w.icon(cr, wx_icon(x.get("code")), cx + 20, 130, 15, "accent")
            w.text(cr, f"{x.get('hi', '?')}° / {x.get('lo', '?')}°", cx, 148, 9.5, False, "dim", 1, "c")
    return False


section(pt, "Weather")
weather = area(CW, 166, wx_draw)
pt.pack_start(weather, False, False, 0)


def today_tick():
    if visible("today"):
        clock.queue_draw()
    return True


ON_SHOW["today"] = lambda: (clock.queue_draw(), wx_load() if WX["state"] != "ok" or time.time() - WX["ts"] > 1800 else None)


# ================================================================== SYSTEM
ps = page("system")


class Ring(Gtk.DrawingArea):
    def __init__(self, label, glyph):
        super().__init__()
        self.label, self.glyph, self.big, self.sub = label, glyph, "–", ""
        self.tw = Tween(self, 0.0, 0.6)
        self.set_size_request(CW // 2 - 6, 168)
        self.connect("draw", self._draw)

    def set(self, frac, big, sub):
        self.big, self.sub = big, sub
        self.tw.go(max(0.0, min(1.0, frac)))
        self.queue_draw()

    def _draw(self, wd, cr):
        W, H = self.get_allocated_width(), self.get_allocated_height()
        soft(cr, 0, 0, W, H, 22, 0.06)
        cx, cy, r = W / 2, 70, 44
        cr.set_line_width(9); cr.set_line_cap(cairo.LINE_CAP_ROUND)
        a0 = math.pi * 0.75
        span = math.pi * 1.5
        cr.arc(cx, cy, r, a0, a0 + span); cr.set_source_rgba(*w.col("fg", 0.1)); cr.stroke()
        v = max(0.0, min(self.tw.v, 1.0))
        if v > 0.003:
            ac, a2 = w.col("accent"), w.col("accent2")
            g = cairo.LinearGradient(cx - r, cy, cx + r, cy)
            g.add_color_stop_rgba(0, *ac[:3], 1); g.add_color_stop_rgba(1, *a2[:3], 1)
            cr.arc(cx, cy, r, a0, a0 + span * v); cr.set_source(g); cr.stroke()
        w.text(cr, self.big, cx, cy + 6, 18, True, "fg", 1, "c")
        w.icon(cr, self.glyph, cx, cy + 40, 13, "accent")
        w.text(cr, self.label, cx, H - 26, 11.5, True, "fg", 1, "c")
        w.text(cr, fit(cr, self.sub, 9.5, W - 16), cx, H - 11, 9.5, False, "dim", 1, "c")
        return False


rings = dict(cpu=Ring("CPU", ""), ram=Ring("Memory", "\U000f035b"), gpu=Ring("GPU", ""), disk=Ring("Disk", ""))
rg = Gtk.Grid(); rg.set_column_spacing(12); rg.set_row_spacing(12)
order = ["cpu", "ram"] + (["gpu"] if HAVE["nvidia-smi"] else []) + ["disk"]
for i, k in enumerate(order):
    rg.attach(rings[k], i % 2, i // 2, 1, 1)
section(ps, "Usage")
ps.pack_start(rg, False, False, 0)


class Info(Gtk.DrawingArea):
    def __init__(self):
        super().__init__()
        self.rows = []
        self.set_size_request(CW, 30)
        self.connect("draw", self._draw)

    def set(self, rows):
        self.rows = rows
        self.set_size_request(CW, 14 + 30 * len(rows))
        self.queue_draw()

    def _draw(self, wd, cr):
        W, H = self.get_allocated_width(), self.get_allocated_height()
        soft(cr, 0, 0, W, H, 22, 0.06)
        for i, (g, k, v) in enumerate(self.rows):
            y = 26 + 30 * i
            w.icon(cr, g, 26, y + 1, 12, "accent")
            w.text(cr, k, 46, y, 10.5, False, "dim")
            w.text(cr, fit(cr, v, 10.5, W - 150, True), W - 18, y, 10.5, True, "fg", 1, "r")
        return False


section(ps, "This computer")
sysinfo = Info()
ps.pack_start(sysinfo, False, False, 0)
SYS = dict(cpu=None, busy=False, cpu_model=None)


def cpu_times():
    with open("/proc/stat") as f:
        p = [int(x) for x in f.readline().split()[1:]]
    idle = p[3] + (p[4] if len(p) > 4 else 0)
    return sum(p), idle


def gib(kb):
    return kb / 1048576.0


def fmt_up(s):
    s = int(s); d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    return (f"{d}d " if d else "") + (f"{h}h " if h or d else "") + f"{m}m"


def sys_poll():
    if SYS["busy"]:
        return
    SYS["busy"] = True

    def work():
        r = {}
        tot, idle = cpu_times()
        if SYS["cpu"]:
            dt, di = tot - SYS["cpu"][0], idle - SYS["cpu"][1]
            r["cpu"] = 1.0 - di / dt if dt > 0 else 0.0
        SYS["cpu"] = (tot, idle)
        mem = {}
        for ln in open("/proc/meminfo"):
            k, v = ln.split(":", 1); mem[k] = int(v.split()[0])
        r["ram"] = (mem["MemTotal"] - mem["MemAvailable"], mem["MemTotal"])
        st = os.statvfs("/")
        r["disk"] = ((st.f_blocks - st.f_bfree) * st.f_frsize, st.f_blocks * st.f_frsize)
        if HAVE["nvidia-smi"]:
            g = out("nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu", "--format=csv,noheader,nounits")
            try:
                u, mu, mt, tp = [x.strip() for x in g.splitlines()[0].split(",")]
                r["gpu"] = (float(u) / 100, float(mu), float(mt), tp)
            except Exception:
                pass
        up = float(open("/proc/uptime").read().split()[0])
        la = os.getloadavg()
        if SYS["cpu_model"] is None:
            SYS["cpu_model"] = next((l.split(":", 1)[1].strip() for l in open("/proc/cpuinfo") if l.startswith("model name")), "")
            SYS["ncpu"] = os.cpu_count() or 1
        un = os.uname()
        r["info"] = [("", "Uptime", fmt_up(up)), ("", "Kernel", f"{un.sysname} {un.release}"),
                     ("", "Load", f"{la[0]:.2f}  {la[1]:.2f}  {la[2]:.2f}"),
                     ("", "Processor", f"{SYS['cpu_model']} ({SYS['ncpu']})"),
                     ("", "Host", un.nodename)]
        return r

    def done(r):
        SYS["busy"] = False
        if not r:
            return
        if "cpu" in r:
            rings["cpu"].set(r["cpu"], f"{r['cpu'] * 100:.0f}%", f"{SYS.get('ncpu', 1)} threads · load {os.getloadavg()[0]:.1f}")
        u, t = r["ram"]
        rings["ram"].set(u / t, f"{u / t * 100:.0f}%", f"{gib(u):.1f} / {gib(t):.0f} GiB")
        u, t = r["disk"]
        rings["disk"].set(u / t if t else 0, f"{u / t * 100:.0f}%" if t else "–", f"{u / 1e9:.0f} / {t / 1e9:.0f} GB on /")
        if "gpu" in r:
            gu, mu, mt, tp = r["gpu"]
            rings["gpu"].set(gu, f"{gu * 100:.0f}%", f"{mu / 1024:.1f} / {mt / 1024:.0f} GiB · {tp}°C")
        sysinfo.set(r["info"])
    bg(work, done)


def sys_tick():
    if visible("system"):
        sys_poll()
    return True


ON_SHOW["system"] = sys_poll


