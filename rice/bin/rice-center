pz = page("customize")


class Preset(Gtk.DrawingArea):
    """Motion preset card: name, description and a dot that plays the preset's curve on hover / select."""

    def __init__(self, key):
        super().__init__()
        self.key, self.p = key, rice.motion(key)
        self.sel = Tween(self, 0.0, 0.25)
        self.hv = Tween(self, 0.0, 0.2)
        self.t0, self.play, self.loop = 0.0, False, False
        self.set_size_request(CW, 52)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("draw", self._draw)
        self.connect("enter-notify-event", lambda *a: (self.hv.go(1.0), self.start(True)))
        self.connect("leave-notify-event", lambda *a: (self.hv.go(0.0), setattr(self, "loop", False)))
        self.connect("button-press-event", self._press)
        self.tk = None

    def start(self, loop=False):
        self.loop = loop
        if not self.play:
            self.play, self.t0 = True, time.monotonic()
        if self.tk is None:
            self.tk = self.add_tick_callback(self._tick)

    def _dur(self):
        sp = float(settings.get("motion_speed") or 1.0) if not hasattr(self, "_sp") else self._sp
        return max(0.75 * self.p["k"] / min(max(sp, 0.5), 2.0), 0.12)

    def _tick(self, wd, clock):
        self.queue_draw()
        t = (time.monotonic() - self.t0) / self._dur()
        if t >= 1.65:                                  # play, rest a moment at the end, then loop or stop
            if self.loop:
                self.t0 = time.monotonic(); return True
            self.play = False; self.tk = None
            return False
        return True

    def _press(self, wd, e):
        if e.button == 1:
            pick_motion(self.key)
        return True

    def _draw(self, wd, cr):
        W, H = self.get_allocated_width(), self.get_allocated_height()
        s, hv = min(max(self.sel.v, 0), 1), self.hv.v
        rice.rounded(cr, 1, 1, W - 2, H - 2, 18)
        cr.set_source_rgba(*mix(w.col("fg"), w.col("accent"), s), 0.06 + 0.04 * hv + 0.12 * s); cr.fill_preserve()
        cr.set_source_rgba(*w.col("accent", 0.85 * s)); cr.set_line_width(1.5); cr.stroke()
        w.text(cr, self.p["label"], 18, 23, 12.5, True)
        w.text(cr, self.p["desc"], 18, 40, 9.5, False, "dim")
        # preview track
        tx0, tx1, ty = W - 150, W - 26, H / 2
        cr.set_line_width(2); cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.move_to(tx0, ty); cr.line_to(tx1, ty); cr.set_source_rgba(*w.col("fg", 0.12)); cr.stroke()
        cr.arc(tx1, ty, 3, 0, 2 * math.pi); cr.set_source_rgba(*w.col("fg", 0.25)); cr.fill()
        t = (time.monotonic() - self.t0) / self._dur() if self.play else 1.0
        v = rice.spring(min(max(t, 0.0), 1.0), self.p)
        if self.p["curve"] == "linear":
            a = min(max(t, 0.0), 1.0) if self.play else 1.0
            x = tx0 + (tx1 - tx0) * v
            cr.arc(x, ty, 7, 0, 2 * math.pi); cr.set_source_rgba(*w.col("accent", 0.35 + 0.65 * a)); cr.fill()
        else:
            x = tx0 + (tx1 - tx0) * v
            if self.play and t < 1.0:                   # faint trail
                for i in range(1, 5):
                    tt = max(t - i * 0.05, 0.0)
                    xx = tx0 + (tx1 - tx0) * rice.spring(tt, self.p)
                    cr.arc(xx, ty, 7 - i, 0, 2 * math.pi); cr.set_source_rgba(*w.col("accent", 0.18 - 0.035 * i)); cr.fill()
            cr.arc(x, ty, 7, 0, 2 * math.pi); cr.set_source_rgba(*w.col("accent")); cr.fill()
        return False


PRESETS = {}


def pick_motion(key):
    settings.put("motion", key)
    rice._MCACHE[1] = None                         # take the new preset at once
    for k, c in PRESETS.items():
        c.sel.go(1.0 if k == key else 0.0)
    PRESETS[key].start(False)


