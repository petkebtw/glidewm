# ---- dock
DOCK = dict(autohide=False, size=48, magnify=True, monitor="primary")
DOCK.update(settings.get("dock") or {})
DT = dict(tm=None)


def dock_reload():
    """Tell a running rice-dock to reload its settings (SIGUSR1 to processes named rice-dock, found by PID)."""
    me = os.getpid()
    for p in os.listdir("/proc"):
        if not p.isdigit() or int(p) == me:
            continue
        try:
            argv = open(f"/proc/{p}/cmdline", "rb").read().split(b"\0")
        except OSError:
            continue
        names = [os.path.basename(a.decode(errors="ignore")) for a in argv[:2]]
        if "rice-dock" in names:
            try: os.kill(int(p), signal.SIGUSR1)
            except OSError: pass


def dock_put(k, v):
    DOCK[k] = v
    if DT["tm"]:
        GLib.source_remove(DT["tm"])

    def save():
        DT["tm"] = None
        d = dict(settings.get("dock") or {}); d.update(DOCK)
        settings.put("dock", d)
        dock_reload()
        return False
    DT["tm"] = GLib.timeout_add(250, save)


