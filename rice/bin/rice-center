class Act(Gtk.DrawingArea):
    def __init__(self, glyph, label, cb):
        super().__init__()
        self.glyph, self.label, self.cb = glyph, label, cb
        self.hv = Tween(self, 0.0, 0.2)
        self.set_size_request(CW // 2 - 5, 48)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("draw", self._draw)
        self.connect("enter-notify-event", lambda *a: self.hv.go(1.0))
        self.connect("leave-notify-event", lambda *a: self.hv.go(0.0))
        self.connect("button-press-event", lambda wd, e: (self.cb(), True)[1] if e.button == 1 else False)

    def _draw(self, wd, cr):
        W, H = self.get_allocated_width(), self.get_allocated_height()
        k = min(max(self.hv.v, 0), 1)
        rice.rounded(cr, 1, 1, W - 2, H - 2, (H - 2) / 2)
        cr.set_source_rgba(*mix(w.col("fg"), w.col("accent"), k), 0.08 + 0.8 * k); cr.fill()
        w.icon(cr, self.glyph, 26, H / 2 + 5, 14, "bg" if k > 0.5 else "accent")
        cr.select_font_face(rice.FONT, 0, 1); cr.set_font_size(11)
        cr.set_source_rgba(*w.col("bg" if k > 0.5 else "fg")); cr.move_to(44, H / 2 + 4); cr.show_text(fit(cr, self.label, 11, W - 54, True))
        return False


