def sp_show(v):
    sp_lab.set_markup(f'<span size="10500" weight="bold">{int(round(v * 100))}%</span>')


def sp_changed(f):
    v = round((0.5 + f * 1.5) / 0.05) * 0.05
    sp_show(v)
    for c in PRESETS.values():
        c._sp = v
    if SPEED["tm"]:
        GLib.source_remove(SPEED["tm"])

    def save():
        SPEED["tm"] = None
        settings.put("motion_speed", round(v, 2)); rice._MCACHE[1] = None
        return False
    SPEED["tm"] = GLib.timeout_add(250, save)


