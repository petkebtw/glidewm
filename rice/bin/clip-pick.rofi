#!/usr/bin/env python3
"""rofi clipboard history picker. Type to filter, arrows, Enter = copy."""
import os, subprocess
D = os.path.expanduser("~/.cache/clip")
fs = sorted(os.listdir(D), reverse=True) if os.path.isdir(D) else []
rows = []
for f in fs:
    p = os.path.join(D, f)
    if f.endswith(".png"):
        rows.append(f"[image]\0icon\x1f{p}")
    else:
        t = " ".join(open(p, errors="ignore").read().split())[:120]
        rows.append(t.replace("\0", ""))
if not rows:
    raise SystemExit
r = subprocess.run(["rofi", "-dmenu", "-i", "-show-icons", "-format", "i", "-p", "\uf0ea",
                    "-theme", os.path.expanduser("~/.config/rofi/clip.rasi")],
                   input="\n".join(rows), capture_output=True, text=True)
if r.returncode == 0 and r.stdout.strip():
    p = os.path.join(D, fs[int(r.stdout)])
    if p.endswith(".png"):
        subprocess.run(["xclip", "-selection", "clipboard", "-t", "image/png", "-i", p])
    else:
        subprocess.run(["xclip", "-selection", "clipboard", "-i", p])
