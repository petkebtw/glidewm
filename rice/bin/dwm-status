#!/bin/bash
# dwm status: "<vol level>\x01<date  time>". Level: m muted, 0..3. Refresh on SIGRTMIN+10 and on every PipeWire
# sink change (pactl subscribe), so the bar icon follows volume changes from any source.
DIRTY=0
trap 'DIRTY=1' RTMIN+10
trap 'kill $SUB 2>/dev/null' EXIT
lvl() {
	local o v
	o=$(timeout 2 wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || { echo 2; return; }
	if [[ $o == *MUTED* ]]; then echo m; return; fi
	v=$(awk '{printf "%d", $2*100+0.5}' <<<"$o")
	if ((v == 0)); then echo m; elif ((v < 34)); then echo 1; elif ((v < 67)); then echo 2; else echo 3; fi
}
ME=$BASHPID
( while :; do
	timeout --foreground 86400 pactl subscribe 2>/dev/null | grep --line-buffered -E "sink|server" | while read -r _; do kill -RTMIN+10 $ME 2>/dev/null; done
	sleep 5
done ) &
SUB=$!
while :; do
	DIRTY=0
	xsetroot -name "$(lvl)"$'\x01'"$(date '+%a %d %b')  $(date '+%H:%M')"
	((DIRTY)) && continue
	sleep 10 & P=$!
	wait $P
	kill $P 2>/dev/null
done
