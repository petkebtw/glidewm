#!/usr/bin/env python3
"""Game bar (DarkShadowShell style): rice-gamebar toggles a glass card with CPU / GPU load + heat, RAM,
ping and switches (microphone, Do Not Disturb, screenshot, record, volume). A second call closes it."""
import os, sys, signal, math, subprocess, threading, fcntl, time

CACHE = os.path.expanduser("~/.cache/rice")
os.makedirs(CACHE, exist_ok=True)
lockf = open(os.path.join(CACHE, "gamebar.lock"), "w")
PIDF = os.path.join(CACHE, "gamebar.pid")
try:
    fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    try:
        os.kill(int(open(PIDF).read()), signal.SIGTERM)
    except Exception:
        pass
    sys.exit(0)
open(PIDF, "w").write(str(os.getpid()))
DND = os.path.join(CACHE, "dnd")

sys.path.insert(0, os.path.expanduser("~/.local/lib/rice"))
import rice
from rice import Gtk, Gdk, GLib

W, H = 560, 172
win = rice.Card(W, H, radius=28)
c = win.c
S = dict(cpu=0.0, cput=None, gpu=0.0, gput=None, ram=0.0, ping=None, mic=False, vol=0.0, mute=False)
_prev = [None]


def sh(cmd, t=2):
    try:
        return subprocess.run(["timeout", str(t)] + cmd, capture_output=True, text=True).stdout
    except Exception:
        return ""


def cpu_temp():
    base = "/sys/class/hwmon"
    try:
        for h in os.listdir(base):
            n = open(f"{base}/{h}/name").read().strip()
            if n in ("k10temp", "coretemp", "zenpower"):
                for f in ("temp1_input", "temp2_input"):
                    try:
                        return int(open(f"{base}/{h}/{f}").read()) / 1000
                    except OSError:
                        pass
    except OSError:
        pass
    return None


def poll():
    try:
        a = [int(x) for x in open("/proc/stat").readline().split()[1:]]
        tot, idle = sum(a), a[3] + a[4]
        if _prev[0]:
            dt, di = tot - _prev[0][0], idle - _prev[0][1]
            S["cpu"] = 100 * (1 - di / dt) if dt else 0
        _prev[0] = (tot, idle)
        m = {l.split(":")[0]: int(l.split()[1]) for l in open("/proc/meminfo")}
        S["ram"] = 100 * (1 - m["MemAvailable"] / m["MemTotal"])
        S["cput"] = cpu_temp()
    except Exception:
        pass
    GLib.idle_add(win.queue_draw)


def slow():
    out = sh(["nvidia-smi", "--query-gpu=temperature.gpu,utilization.gpu", "--format=csv,noheader,nounits"])
    try:
        t, u = [float(x) for x in out.split(",")]
        S["gput"], S["gpu"] = t, u
    except ValueError:
        pass
    p = sh(["ping", "-c1", "-W1", "1.1.1.1"], 3)
    try:
        S["ping"] = float(p.split("time=")[1].split()[0])
    except Exception:
        S["ping"] = None
    S["mic"] = "MUTED" in sh(["wpctl", "get-volume", "@DEFAULT_AUDIO_SOURCE@"])
    v = sh(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    try:
        S["vol"], S["mute"] = float(v.split()[1]), "MUTED" in v
    except Exception:
        pass
    GLib.idle_add(win.queue_draw)


def loop():
    n = 0
    while True:
        poll()
        if n % 3 == 0:
            slow()
        n += 1
        time.sleep(1)


area = Gtk.DrawingArea()
area.set_size_request(W, H)
win.add(area)
win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
BTN = []


def _loop(cr, kind, cx, cy, r, t0, t1):
    """Ring outline of the design: round, cookie (material3) or square (brutal); t0..t1 = fraction from the top."""
    cr.new_sub_path()
    n = max(int(120 * (t1 - t0)), 2)
    for i in range(n + 1):
        t = t0 + (t1 - t0) * i / n
        a = -math.pi / 2 + 2 * math.pi * t
        if kind == "material3":
            rr = r * (0.93 + 0.07 * math.cos(10 * 2 * math.pi * t))
            x, y = cx + rr * math.cos(a), cy + rr * math.sin(a)
        elif kind == "brutal":
            c, s_ = math.cos(a), math.sin(a)
            k = r / max(abs(c), abs(s_))
            x, y = cx + c * k * 0.95, cy + s_ * k * 0.95
        else:
            x, y = cx + r * math.cos(a), cy + r * math.sin(a)
        (cr.move_to if i == 0 else cr.line_to)(x, y)


def ring(cr, cx, cy, r, frac, col, label, val, sub):
    kind = c.get("design", "default")
    cr.set_line_width(7 if kind != "brutal" else 6)
    cr.set_line_cap(1 if kind != "brutal" else 0)
    cr.set_source_rgba(*rice.rgb(c["dim"], 0.28))
    _loop(cr, kind, cx, cy, r, 0, 1)
    cr.stroke()
    cr.set_source_rgba(*rice.rgb(col))
    _loop(cr, kind, cx, cy, r, 0, max(0.02, min(1, frac)))
    cr.stroke()
    cr.select_font_face(rice.SANS_FONT, 0, 1)
    cr.set_font_size(15)
    e = cr.text_extents(val)
    cr.set_source_rgba(*rice.rgb(c["fg"]))
    cr.move_to(cx - e.x_advance / 2, cy + 5)
    cr.show_text(val)
    cr.select_font_face(rice.SANS_FONT, 0, 0)
    cr.set_font_size(11)
    for i, t in enumerate((label, sub)):
        if not t:
            continue
        e = cr.text_extents(t)
        cr.set_source_rgba(*rice.rgb(c["dim"]))
        cr.move_to(cx - e.x_advance / 2, cy + r + 16 + i * 13)
        cr.show_text(t)


def tog(cr, x, y, w, label, on):
    kind = c.get("design", "default")
    cr.set_source_rgba(*rice.rgb(c["accent"] if on else c["bg2"], 0.95))
    if kind == "brutal":
        cr.rectangle(x, y, w, 30); cr.fill_preserve()
        cr.set_source_rgba(*rice.rgb(c["fg"])); cr.set_line_width(2.5); cr.stroke()
    else:
        rice.rounded(cr, x, y, w, 30, 9 if kind == "macos" else 15)
        cr.fill()
    cr.select_font_face(rice.SANS_FONT, 0, 1)
    cr.set_font_size(12)
    e = cr.text_extents(label)
    cr.set_source_rgba(*rice.rgb(c["bg"] if on else c["fg"]))
    cr.move_to(x + (w - e.x_advance) / 2, y + 19.5)
    cr.show_text(label)


def draw(w, cr):
    BTN.clear()
    ring(cr, 54, 50, 28, S["cpu"] / 100, c["accent"], "CPU", f"{S['cpu']:.0f}%", f"{S['cput']:.0f}°C" if S["cput"] else "")
    ring(cr, 140, 50, 28, S["gpu"] / 100, c["accent2"], "GPU", f"{S['gpu']:.0f}%", f"{S['gput']:.0f}°C" if S["gput"] else "")
    ring(cr, 226, 50, 28, S["ram"] / 100, c["accent"], "RAM", f"{S['ram']:.0f}%", "")
    p = S["ping"]
    ring(cr, 312, 50, 28, 0 if p is None else min(1, p / 150), c["accent2"], "PING", "--" if p is None else f"{p:.0f}", "ms")
    # volume bar
    vx, vy, vw = 366, 44, 170
    cr.set_line_width(6); cr.set_line_cap(1)
    cr.set_source_rgba(*rice.rgb(c["dim"], 0.3)); cr.move_to(vx, vy + 6); cr.line_to(vx + vw, vy + 6); cr.stroke()
    cr.set_source_rgba(*rice.rgb(c["dim"] if S["mute"] else c["accent"]))
    cr.move_to(vx, vy + 6); cr.line_to(vx + vw * min(1, S["vol"]), vy + 6); cr.stroke()
    cr.select_font_face(rice.SANS_FONT, 0, 0); cr.set_font_size(11)
    cr.set_source_rgba(*rice.rgb(c["dim"]))
    cr.move_to(vx, vy - 8); cr.show_text("Volume" + (" (muted)" if S["mute"] else f" {S['vol'] * 100:.0f}%"))
    BTN.append(("vol", vx, vy - 6, vx + vw, vy + 18))
    # switches
    items = [("mic", "Mic off" if S["mic"] else "Mic on", S["mic"]), ("dnd", "Do not disturb", os.path.exists(DND)),
             ("shot", "Screenshot", False), ("rec", "Record", False)]
    x, y = 20, 128
    for k, lab, on in items:
        wd = 120 if k == "dnd" else 100
        tog(cr, x, y, wd, lab, on)
        BTN.append((k, x, y, x + wd, y + 30))
        x += wd + 10


def press(w, e):
    for k, x0, y0, x1, y1 in BTN:
        if x0 <= e.x <= x1 and y0 <= e.y <= y1:
            if k == "mic":
                sh(["wpctl", "set-mute", "@DEFAULT_AUDIO_SOURCE@", "toggle"])
                S["mic"] = not S["mic"]
            elif k == "dnd":
                if os.path.exists(DND):
                    os.remove(DND)
                else:
                    open(DND, "w").close()
            elif k == "vol":
                f = max(0, min(1, (e.x - x0) / (x1 - x0)))
                sh(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{f:.2f}"])
                S["vol"] = f
            elif k in ("shot", "rec"):
                cmd = ["sh", "-c", "sleep 0.6; exec " + ("screenshot.sh" if k == "shot" else "rice-record")]   # after the card has faded
                close(lambda: subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
                return True
            win.queue_draw()
            return True
    return True


closing = [False]


def close(after=None):
    if closing[0]:
        return
    closing[0] = True
    if after:
        after()
    win.quit_anim()


area.connect("draw", draw)
win.connect("button-press-event", press)
win.connect("destroy", lambda *_: Gtk.main_quit())
win.connect("key-press-event", lambda w, e: close() if e.keyval == Gdk.KEY_Escape else None)
g = rice.primary_geometry()
win.move(g.x + (g.width - W) // 2, g.y + 56)
win.show_all()
threading.Thread(target=loop, daemon=True).start()
GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: (close(), True)[1])
Gtk.main()
try:
    os.remove(PIDF)
except OSError:
    pass
